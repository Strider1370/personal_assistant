# ──────────────────────────────────────────────────────────────
# Personal Assistant — environment template (GCP server)
# Copy to `.env` on the server and fill in real values.
# NEVER commit the real .env. Keep it at: /home/junn1370/personal_assistant/.env
# ──────────────────────────────────────────────────────────────

# --- Storage (absolute server paths) ---
OBSIDIAN_VAULT_PATH=/home/junn1370/personal_assistant/Obsidian_vault
ASSISTANT_DB_PATH=/home/junn1370/personal_assistant/assistant/data/assistant.db

# --- Assistant API ---
ASSISTANT_PORT=3010
# OpenClaw bridge -> assistant API (same host, loopback).
ASSISTANT_BASE_URL=http://127.0.0.1:3010
# Optional shared secret (sent as X-Assistant-Key). Leave empty to disable.
ASSISTANT_API_KEY=

# --- LLM (Alibaba, OpenAI-compatible) ---
LLM_PROVIDER=alibaba
LLM_BASE_URL=https://ws-hn1artvm7ezt97zj.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=__set_me__
LLM_MODEL=deepseek-v4-flash
LLM_ENABLE_THINKING=false

# --- Telegram ---
TELEGRAM_BOT_TOKEN=__set_me__
TELEGRAM_CHAT_ID=8333411467

# --- Notion ---
NOTION_TOKEN=__set_me__
NOTION_DATABASE_ID=__set_me__

# --- Digest ---
DIGEST_TIMEZONE=Asia/Seoul

# --- OpenClaw gateway (server paths) ---
OPENCLAW_CONFIG_PATH=/home/junn1370/personal_assistant/openclaw/openclaw.gcp.json
OPENCLAW_STATE_DIR=/home/junn1370/personal_assistant/openclaw/.state
